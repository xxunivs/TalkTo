.env
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
.DS_Store
*.log
tmp/
*.wav
*.mp3
*.m4a
*.aac
*.amr

# bake-off outputs contain transcripts; never commit
evaluation/transcription/bakeoff/results*/
evaluation/transcription/gold/
evaluation/transcription/results/
# real family data for tests; never commit
data/fixtures/
# 신금자(실대상자) 페르소나 산출·평가 결과물; never commit
evaluation/persona/results/*singeumja*
evaluation/persona/results/*_sg.*
# audio + external datasets; never commit
data/
# 예외: manual 빌드(신금자 등)는 실행에 data/(기억·임베딩)가 필요해 함께 배포된다.
# 이 레포는 private이며, 원본 음성·mp3·평가 산출물은 아래에서 다시 제외한다.
!manual_persona/*/data/
!manual_persona/*/data/**
manual_persona/*/data/voice_raw/
manual_persona/*/data/*.mp3
manual_persona/*/data/eval_results/
# e2e 전사 캐시(외부 오디오 파생, 재전사 방지용 로컬 캐시)
evaluation/e2e/.transcription_cache/

# 폐기 예정 보관함 (실제 삭제 보류, git 추적 제외)
delete/

# 전사 캐시 (유료 API 재호출 방지용 로컬 파생물, 원본에서 재생성 가능)
.transcription_cache/
