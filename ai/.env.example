APP_ENV=local
LOG_LEVEL=INFO
AI_SERVER_TOKEN=

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_ANALYSIS_MODEL=gpt-6-luna
OPENAI_JUDGE_MODEL=gpt-5.5
OPENAI_STT_MODEL=whisper-1
OPENAI_CORRECTION_MODEL=gpt-6-luna
CORRECTION_MAX_JAMO_RATIO=0.45
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2

# 새 목소리를 만드는 곳의 기본값(elevenlabs | minimax). 보통은 BE 가 녹음을 보고 정해 준다:
# 통화 녹음 → minimax, 일반 녹음 → elevenlabs(v4). 합성은 목소리 id 로 알아서 고른다.
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
# 비우면 eleven_v4_turbo(감정 표현이 좋고 빠름, style·speed 는 안 씀). v4 학습 안 된 PVC 는 v2 로 되돌림
ELEVENLABS_MODEL=eleven_v4_turbo
ELEVENLABS_DEFAULT_VOICE_ID=

SPEAKER_ID_THRESHOLD=0.5

STT_PROVIDER=elevenlabs
ELEVENLABS_STT_MODEL=scribe_v1
STT_TIMEOUT_SECONDS=1800
AUDIO_DOWNLOAD_TIMEOUT_SECONDS=120
PREVIEW_WINDOW_MS=180000
MIN_SPEECH_MS=3000

MAX_AUDIO_BYTES=
TEMP_DIR=

RTZR_CLIENT_ID=
RTZR_CLIENT_SECRET=

# 타입캐스트 (선택)
TYPECAST_API_KEY=

# MiniMax (선택)
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_MODEL=speech-2.8-turbo
# 비우면 문장 보고 MiniMax 가 감정을 고른다(블라인드 테스트에서 차분함 고정보다 나았다)
MINIMAX_EMOTION=
# +면 부드럽게(-100~100). 할머니 테스트에서 60 은 오히려 별로였다
MINIMAX_INTENSITY=0
# 대답 음성 감정: off(목소리 회사에 맡김) | inline(대답 LLM 이 같은 호출에서 감정을 골라 붙임)
VOICE_EMOTION=off
