APP_ENV=local
LOG_LEVEL=INFO
AI_SERVER_TOKEN=

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6-luna
# 대답 생성의 추론 정도: none|low|medium|high (빈 값 = 모델 기본, 느림)
OPENAI_CHAT_REASONING_EFFORT=none
OPENAI_ANALYSIS_MODEL=gpt-6-luna
OPENAI_JUDGE_MODEL=gpt-5.5
OPENAI_STT_MODEL=whisper-1
OPENAI_CORRECTION_MODEL=gpt-6-luna
CORRECTION_MAX_JAMO_RATIO=0.45
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2

# 목소리: 새 목소리는 늘 Fish Audio(drama-3)에서 만들고 합성한다. 예전에 만든 목소리는 다시 만들기 전까지
# 목소리 id 로 그 회사에서 합성·지운다(fish_… → Fish, TalkTo… → MiniMax, 그 밖 → ElevenLabs).
FISH_AUDIO_API_KEY=
# voice_id 없이 회사를 고를 때의 기본값(fish). 새 목소리 만들기는 이 값과 무관하게 Fish 다.
TTS_PROVIDER=fish
# ElevenLabs: 녹음 전사(Scribe)와 예전 목소리 합성·지우기
ELEVENLABS_API_KEY=
# 비우면 eleven_v4_turbo(감정 표현이 좋고 빠름, style·speed 는 안 씀). 즉시 복제(IVC)가 아닌 예전 목소리는 v2 로 되돌림
ELEVENLABS_MODEL=eleven_v4_turbo
ELEVENLABS_DEFAULT_VOICE_ID=

SPEAKER_ID_THRESHOLD=0.5

STT_PROVIDER=elevenlabs
# scribe_v1 은 지원 종료(ElevenLabs 공지, 2026-07-09). v2 를 이름으로 고정
ELEVENLABS_STT_MODEL=scribe_v2
STT_TIMEOUT_SECONDS=1800
AUDIO_DOWNLOAD_TIMEOUT_SECONDS=120
PREVIEW_WINDOW_MS=180000
MIN_SPEECH_MS=3000

MAX_AUDIO_BYTES=
TEMP_DIR=

RTZR_CLIENT_ID=
RTZR_CLIENT_SECRET=

# 타입캐스트 (선택)
TYPECAST_API_KEY=

# MiniMax (예전 목소리 합성·지우기만. 새 목소리는 만들지 않는다)
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_MODEL=speech-2.8-turbo
# 비우면 문장 보고 MiniMax 가 감정을 고른다(청취 비교에서 차분함 고정보다 나았다)
MINIMAX_EMOTION=
# +면 부드럽게, -면 힘 있게(-100~100). 60 은 청취에서 오히려 나빴다
MINIMAX_INTENSITY=0
# 대답 음성 감정: off(목소리 회사에 맡김) | inline(대답 LLM 이 같은 호출에서 감정을 골라 붙임)
VOICE_EMOTION=off

# 페르소나 프롬프트·중간계층 기능 플래그(주석 = 기본값, 기존 동작). 뜻은 README 의 환경 변수 표
# PERSONA_PROMPT_BUILDER=legacy
# PERSONA_DEATH_TALK=intake
# PERSONA_ORCHESTRATOR=false
# ORCHESTRATOR_ASSEMBLER=legacy
# ORCHESTRATOR_RULES=legacy
# ORCHESTRATOR_SHOTS=system
# ORCHESTRATOR_PERSONA_DIR=personas_local    (기본 없음 — 쓸 때 경로를 준다)
# ORCHESTRATOR_SELECTOR=passthrough
# ORCHESTRATOR_PRECHECK=noop
# ORCHESTRATOR_GUARD=pass
# ORCHESTRATOR_LANG_GUARD=off
# ORCHESTRATOR_TRACE_DIR=orchestrator_traces (기본 없음 — 대화 원문이 남으니 git 밖 경로로)
