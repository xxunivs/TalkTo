[{"id": null, "segmentIndex": 0, "startMs": 100, "endMs": 1420, "speakerLabel": "SPK_0", "transcriptText": "있었어?", "confidence": 0.8697, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 1, "startMs": 1420, "endMs": 4520, "speakerLabel": "SPK_1", "transcriptText": "어. 할머니, 근데 할머니는.", "confidence": 0.9789, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 2, "startMs": 4520, "endMs": 5480, "speakerLabel": "SPK_0", "transcriptText": "어.", "confidence": 0.9787, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 3, "startMs": 5480, "endMs": 7760, "speakerLabel": "SPK_1", "transcriptText": "불, 불고기 만들 때 양념 어떻게 해?", "confidence": 0.9872, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 4, "startMs": 9140, "endMs": 10460, "speakerLabel": "SPK_0", "transcriptText": "뭐 만들 적에?", "confidence": 0.9967, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 5, "startMs": 10460, "endMs": 12440, "speakerLabel": "SPK_1", "transcriptText": "불고기, 불고기.", "confidence": 1.0, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 6, "startMs": 12440, "endMs": 23600, "speakerLabel": "SPK_0", "transcriptText": "어. 거기다 저기 뭐 후춧가루도 넣고 양파도 썰어 넣고 당근도 있으면 썰어서 넣고 그래.", "confidence": 0.9436, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 7, "startMs": 25020, "endMs": 28260, "speakerLabel": "SPK_1", "transcriptText": "아니, 아니, 그 양념 비율은, 간장은 몇 숟갈 넣어?", "confidence": 0.9992, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 8, "startMs": 29620, "endMs": 30880, "speakerLabel": "SPK_0", "transcriptText": "얼마나 되는데, 그게?", "confidence": 0.9894, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 9, "startMs": 33000, "endMs": 33420, "speakerLabel": "SPK_1", "transcriptText": "응?", "confidence": 0.9978, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 10, "startMs": 33420, "endMs": 34560, "speakerLabel": "SPK_0", "transcriptText": "한 근이야, 반 근이야?", "confidence": 0.9738, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 11, "startMs": 36200, "endMs": 37400, "speakerLabel": "SPK_1", "transcriptText": "한 근이 몇 그램이지?", "confidence": 0.9885, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 12, "startMs": 38960, "endMs": 40980, "speakerLabel": "SPK_0", "transcriptText": "한 근이 600g.", "confidence": 0.9658, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 13, "startMs": 41660, "endMs": 43400, "speakerLabel": "SPK_1", "transcriptText": "아, 반, 반도 안 되지.", "confidence": 0.9972, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 14, "startMs": 44920, "endMs": 47380, "speakerLabel": "SPK_0", "transcriptText": "어, 반 근이야, 되니? 300g이야?", "confidence": 0.9746, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 15, "startMs": 48720, "endMs": 50820, "speakerLabel": "SPK_1", "transcriptText": "그, 그거보다 더 적어.", "confidence": 0.967, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 16, "startMs": 50820, "endMs": 55620, "speakerLabel": "SPK_0", "transcriptText": "어. 그러면 한 숟가락만 쳐. 짜면 맛없으니까.", "confidence": 0.944, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 17, "startMs": 55620, "endMs": 57340, "speakerLabel": "SPK_1", "transcriptText": "아, 간장을 한 숟가락밖에 안 쳐?", "confidence": 0.9992, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 18, "startMs": 58640, "endMs": 59920, "speakerLabel": "SPK_0", "transcriptText": "반 근도 안 된대며.", "confidence": 0.9056, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 19, "startMs": 61940, "endMs": 64280, "speakerLabel": "SPK_1", "transcriptText": "뭔 소리여? 간장 말이여, 간장.", "confidence": 0.9298, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 20, "startMs": 66860, "endMs": 69260, "speakerLabel": "SPK_0", "transcriptText": "간장 그러니까 반 근이면은.", "confidence": 0.9875, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 21, "startMs": 69260, "endMs": 70340, "speakerLabel": "SPK_1", "transcriptText": "어.", "confidence": 0.9994, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 22, "startMs": 70340, "endMs": 73560, "speakerLabel": "SPK_0", "transcriptText": "두 숟가락 치면은 짤지 몰라.", "confidence": 0.9994, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 23, "startMs": 73560, "endMs": 73840, "speakerLabel": "SPK_1", "transcriptText": "아, 그래?", "confidence": 0.9812, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 24, "startMs": 73840, "endMs": 78180, "speakerLabel": "SPK_0", "transcriptText": "싱겁게, 어, 싱겁게 먹으니까 간장 많이 치면 짜잖아.", "confidence": 0.9916, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 25, "startMs": 78180, "endMs": 79780, "speakerLabel": "SPK_1", "transcriptText": "맞아. 어.", "confidence": 0.8271, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 26, "startMs": 79780, "endMs": 84360, "speakerLabel": "SPK_0", "transcriptText": "그러니까 한 숟가락 반 치든가 반 근도 안 되면 조금 쳐야 돼.", "confidence": 0.9496, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 27, "startMs": 85640, "endMs": 86700, "speakerLabel": "SPK_1", "transcriptText": "아.", "confidence": 1.0, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 28, "startMs": 86700, "endMs": 91560, "speakerLabel": "SPK_0", "transcriptText": "어. 당근, 양파도 넣고. 그전에 매실청 조금 주었지?", "confidence": 0.9152, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 29, "startMs": 91680, "endMs": 96770, "speakerLabel": "SPK_1", "transcriptText": "근데 그거 아직도 써도 될까? 이제 그거 뭐 계속 써도 되는 거야?", "confidence": 0.9928, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 30, "startMs": 96770, "endMs": 98940, "speakerLabel": "SPK_0", "transcriptText": "어. 어디다 두었니?", "confidence": 0.9918, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 31, "startMs": 98940, "endMs": 100200, "speakerLabel": "SPK_1", "transcriptText": "냉장고에.", "confidence": 0.9998, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 32, "startMs": 100200, "endMs": 102060, "speakerLabel": "SPK_0", "transcriptText": "괜찮아. 1년을 먹는 거야.", "confidence": 0.954, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 33, "startMs": 102060, "endMs": 105100, "speakerLabel": "SPK_1", "transcriptText": "허, 그래? 되게 길구나.", "confidence": 0.9811, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 34, "startMs": 105100, "endMs": 107460, "speakerLabel": "SPK_0", "transcriptText": "어. 2년까지는 괜찮대.", "confidence": 0.9966, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 35, "startMs": 107460, "endMs": 109479, "speakerLabel": "SPK_1", "transcriptText": "우와, 신기하다.", "confidence": 0.9999, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 36, "startMs": 109480, "endMs": 123160, "speakerLabel": "SPK_0", "transcriptText": "어. 그 매실청이니까, 요 설탕하고 반반씩. 그게 1kg면 설탕도 1kg 넣어가지고 1:1로 그렇게 담아놔. 그걸 그 1년, 2년 먹어.", "confidence": 0.8794, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 37, "startMs": 124480, "endMs": 128038, "speakerLabel": "SPK_1", "transcriptText": "아, 그러면은 저거는 그러면 한 숟갈 정도만 넣는 거야?", "confidence": 0.9877, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 38, "startMs": 129440, "endMs": 136920, "speakerLabel": "SPK_0", "transcriptText": "어. 반 근도 안 되니깐 많이 달지 않게 먹으려면 한 숟, 한 숟가락만 넣어봐. 한 수저만 넣어봐.", "confidence": 0.9891, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 39, "startMs": 136920, "endMs": 139300, "speakerLabel": "SPK_1", "transcriptText": "아, 그래, 그래, 그래.", "confidence": 0.9994, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 40, "startMs": 139300, "endMs": 145640, "speakerLabel": "SPK_0", "transcriptText": "그리고 간장, 간장 한 수저만 넣고 그 매실도 한 수, 한 수, 숟가락으로 한 숟가락 넣고.", "confidence": 0.9398, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 41, "startMs": 145640, "endMs": 146260, "speakerLabel": "SPK_1", "transcriptText": "응.", "confidence": 0.8549, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 42, "startMs": 146260, "endMs": 150230, "speakerLabel": "SPK_0", "transcriptText": "후추도 넣고, 넣고 당근, 양파는 있어?", "confidence": 0.9565, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 43, "startMs": 151940, "endMs": 152460, "speakerLabel": "SPK_1", "transcriptText": "어.", "confidence": 1.0, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 44, "startMs": 153580, "endMs": 157120, "speakerLabel": "SPK_0", "transcriptText": "어. 그런 것도 조금 넣고 이제 야채도 먹는 거야, 거기다 섞어서.", "confidence": 0.9347, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 45, "startMs": 158600, "endMs": 161680, "speakerLabel": "SPK_1", "transcriptText": "할머니 근데 앞, 앞다리살 쓴다 그랬나?", "confidence": 0.902, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 46, "startMs": 162660, "endMs": 163260, "speakerLabel": "SPK_0", "transcriptText": "앞다리살?", "confidence": 0.9724, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 47, "startMs": 164600, "endMs": 166280, "speakerLabel": "SPK_1", "transcriptText": "어디 스, 어디 부위 쓴다 그랬지?", "confidence": 0.9196, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 48, "startMs": 168160, "endMs": 171860, "speakerLabel": "SPK_0", "transcriptText": "할머니는... 소고기니?", "confidence": 0.9981, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 49, "startMs": 173100, "endMs": 173520, "speakerLabel": "SPK_1", "transcriptText": "어.", "confidence": 1.0, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 50, "startMs": 176340, "endMs": 182859, "speakerLabel": "SPK_0", "transcriptText": "어디서 기름 없이 연한 데로 달라고 그러면 알아서 주는데. 앞다리살이 뭐 기름이 없다고 그래.", "confidence": 0.9788, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 51, "startMs": 182860, "endMs": 184200, "speakerLabel": "SPK_1", "transcriptText": "앞다리?", "confidence": 1.0, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 52, "startMs": 184200, "endMs": 190900, "speakerLabel": "SPK_0", "transcriptText": "응. 앞다리나 뭐... 앞다리가 뭐 맛있고 그렇더라, 맛있다고.", "confidence": 0.8965, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 53, "startMs": 190900, "endMs": 191810, "speakerLabel": "SPK_1", "transcriptText": "아, 그래?", "confidence": 0.9999, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 54, "startMs": 191810, "endMs": 195920, "speakerLabel": "SPK_0", "transcriptText": "그리고 살 때는, 살 때는 꼭 기름 없는 데로 달라고 그래.", "confidence": 0.9777, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 55, "startMs": 195920, "endMs": 197180, "speakerLabel": "SPK_1", "transcriptText": "아.", "confidence": 1.0, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 56, "startMs": 197180, "endMs": 199780, "speakerLabel": "SPK_0", "transcriptText": "기름 먹으면 좋지 않으니까, 그게.", "confidence": 0.9905, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 57, "startMs": 199780, "endMs": 205880, "speakerLabel": "SPK_1", "transcriptText": "근데 그 기름이, 그 기름이 그거 하얀 부분이 많으면 기름이 많은 거지?", "confidence": 0.9571, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 58, "startMs": 205880, "endMs": 206030, "speakerLabel": "SPK_0", "transcriptText": "어.", "confidence": 0.8687, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 59, "startMs": 206030, "endMs": 206140, "speakerLabel": "SPK_1", "transcriptText": "응.", "confidence": 0.8394, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 60, "startMs": 208420, "endMs": 209799, "speakerLabel": "SPK_0", "transcriptText": "하얀 데가 기름이야, 그게.", "confidence": 0.9994, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 61, "startMs": 211400, "endMs": 218780, "speakerLabel": "SPK_1", "transcriptText": "그래? 근데, 어, 그래? 할머니는 근데 고기 어디서 사는데? 나는 마트에서 사면은.", "confidence": 0.9787, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 62, "startMs": 218780, "endMs": 219120, "speakerLabel": "SPK_0", "transcriptText": "응.", "confidence": 0.956, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 63, "startMs": 219120, "endMs": 222360, "speakerLabel": "SPK_1", "transcriptText": "그거를 이미 포장이 돼 있고 내가 고를 수가 없는데.", "confidence": 0.9985, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 64, "startMs": 224060, "endMs": 226520, "speakerLabel": "SPK_0", "transcriptText": "근데 거기서 그거 봐주는 사람 있지.", "confidence": 0.9642, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 65, "startMs": 227540, "endMs": 227960, "speakerLabel": "SPK_1", "transcriptText": "없는데?", "confidence": 0.9507, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 66, "startMs": 229580, "endMs": 236840, "speakerLabel": "SPK_0", "transcriptText": "마트에 가면 없어? 그냥 자기 골라서 사려면은 거기 그 하얀 거 없는 거 사. 하얀 데가 그게 다 기름이니까.", "confidence": 0.9359, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 67, "startMs": 236840, "endMs": 241320, "speakerLabel": "SPK_1", "transcriptText": "근데 할머니는 뭐 고기 어디서 사는데? 정동 마트에서 사? 아니면 이마트에서 사?", "confidence": 0.9899, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 68, "startMs": 243300, "endMs": 251240, "speakerLabel": "SPK_0", "transcriptText": "아니, 저기 고깃집 안에 있어. 고깃간이 저, 따로 고깃간이 있는데 거기도 조금 싼 데서 사.", "confidence": 0.9, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 69, "startMs": 251240, "endMs": 254520, "speakerLabel": "SPK_1", "transcriptText": "아, 그래? 할머니 정육점 가는 데 따로 있구나.", "confidence": 0.9653, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 70, "startMs": 254520, "endMs": 255580, "speakerLabel": "SPK_0", "transcriptText": "어.", "confidence": 0.9999, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 71, "startMs": 255580, "endMs": 256380, "speakerLabel": "SPK_1", "transcriptText": "아, 역시.", "confidence": 1.0, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 72, "startMs": 257800, "endMs": 263040, "speakerLabel": "SPK_0", "transcriptText": "그 마트에는 다 포장돼 있어도 사람이 보는 데 있잖아. 봐주는 데.", "confidence": 0.9501, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 73, "startMs": 263040, "endMs": 266900, "speakerLabel": "SPK_1", "transcriptText": "그래? 아니, 내가 다니는 마트는 작아서 없어.", "confidence": 0.9998, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 74, "startMs": 266900, "endMs": 269840, "speakerLabel": "SPK_0", "transcriptText": "어. 자기가 골라가야 되는구나.", "confidence": 0.961, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 75, "startMs": 269840, "endMs": 274599, "speakerLabel": "SPK_1", "transcriptText": "아이, 그리고, 그리고 계셔도 잘 모르셔. 내가 알아서 골라야 돼.", "confidence": 0.9744, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 76, "startMs": 274600, "endMs": 283440, "speakerLabel": "SPK_0", "transcriptText": "어. 그러면 거기 써있는 거 봐. 기름, 기름 없는 거, 하얀 게 기름이니까 하얀 데 많이 없는 데로 골라서 사야 돼.", "confidence": 0.9808, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 77, "startMs": 284580, "endMs": 286280, "speakerLabel": "SPK_1", "transcriptText": "그려, 그려.", "confidence": 0.9924, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 78, "startMs": 286280, "endMs": 289020, "speakerLabel": "SPK_0", "transcriptText": "어. 아직 안 먹었구나.", "confidence": 0.9997, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 79, "startMs": 289020, "endMs": 294960, "speakerLabel": "SPK_1", "transcriptText": "아니, 나 먹었어. 이제, 아니, 근데 또 이제 정리를 해둘라고.", "confidence": 0.9883, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 80, "startMs": 294960, "endMs": 295039, "speakerLabel": "SPK_0", "transcriptText": "어.", "confidence": 0.9981, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 81, "startMs": 295040, "endMs": 305000, "speakerLabel": "SPK_1", "transcriptText": "메모를 남겨둘라고. 아, 할머니 게 맛있으니까. 아니, 내가, 내가 어, 얼마 전에 그거, 내가 인터넷에서, 그러니까 내가 핸드폰으로 보고.", "confidence": 0.9737, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 82, "startMs": 305000, "endMs": 305320, "speakerLabel": "SPK_0", "transcriptText": "응.", "confidence": 0.9999, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 83, "startMs": 305320, "endMs": 309520, "speakerLabel": "SPK_1", "transcriptText": "만든, 만들었는데 내가 그때 간장을 여러 숟갈 넣었더니 너무 짠 거야.", "confidence": 0.9974, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 84, "startMs": 310570, "endMs": 311280, "speakerLabel": "SPK_0", "transcriptText": "어.", "confidence": 0.999, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 85, "startMs": 311880, "endMs": 315340, "speakerLabel": "SPK_1", "transcriptText": "그래가지고 아, 역시 할머니는 딱 한 숟가락만 넣는구나.", "confidence": 0.9805, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 86, "startMs": 316440, "endMs": 322360, "speakerLabel": "SPK_0", "transcriptText": "어. 고기 300g도 안 되면은 한 숟가락만 넣어도 돼, 짜게 안 먹으려면.", "confidence": 0.999, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 87, "startMs": 322360, "endMs": 326260, "speakerLabel": "SPK_1", "transcriptText": "아니, 내가 저번에 한 대여섯 숟갈 넣었거든. 너무 짠 거야.", "confidence": 0.9988, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 88, "startMs": 326260, "endMs": 327900, "speakerLabel": "SPK_0", "transcriptText": "너무 짜지.", "confidence": 0.9998, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 89, "startMs": 327900, "endMs": 333800, "speakerLabel": "SPK_1", "transcriptText": "아니, 근데 내가 그 본 거기 영상에서 그 사람이 되게 많이 넣더라고. 그래서 나도 따라 했지.", "confidence": 0.9753, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 90, "startMs": 333800, "endMs": 337800, "speakerLabel": "SPK_0", "transcriptText": "어. 근데 너무 짜게 되면 맛이 없잖아, 또. 안, 몸에도 안 좋고.", "confidence": 0.9791, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 91, "startMs": 337800, "endMs": 338540, "speakerLabel": "SPK_1", "transcriptText": "그렇지.", "confidence": 0.9998, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 92, "startMs": 340940, "endMs": 347500, "speakerLabel": "SPK_0", "transcriptText": "그래, 그 조금 쳐서 가지고 싱거우면 또 먹을 때 조금 쳐도 되고 참기름 있으면 조금 치고 그래.", "confidence": 0.9557, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 93, "startMs": 347500, "endMs": 349580, "speakerLabel": "SPK_1", "transcriptText": "아, 여기 참기름도 쳐? 음.", "confidence": 0.8511, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 94, "startMs": 349580, "endMs": 353640, "speakerLabel": "SPK_0", "transcriptText": "어. 참기름인 데 쳐도 되고 들기름을 쳐도 되고.", "confidence": 0.947, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 95, "startMs": 353640, "endMs": 354340, "speakerLabel": "SPK_1", "transcriptText": "아, 그래?", "confidence": 1.0, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 96, "startMs": 356180, "endMs": 356280, "speakerLabel": "SPK_0", "transcriptText": "어.", "confidence": 0.9039, "correctedText": null, "needsReview": false}, {"id": null, "segmentIndex": 97, "startMs": 356280, "endMs": 357160, "speakerLabel": "SPK_1", "transcriptText": "참기름 한 숟갈?", "confidence": 0.9998, "correctedText": null, "needsReview"