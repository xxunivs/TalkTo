      "correctedText": null,
      "needsReview": false
    },
    {
      "id": null,
      "segmentIndex": 4,
      "startMs": 22819,
      "endMs": 27079,
      "speakerLabel": "SPK_0",
      "transcriptText": "나는 지금 시골 사니까 동네 분위기도 좋고 하니까 가고 싶은데.",
      "confidence": 0.9985,
      "correctedText": null,
      "needsReview": false
