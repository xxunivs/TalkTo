    {
      "segmentIndex": 12,
      "startMs": 35220,
      "endMs": 40120,
      "speakerLabel": "SPK_0",
      "transcriptText": "후회도 조금 해주려면 할머니가 준비를 해놨지."
    },
    {
      "segmentIndex": 13,
      "startMs": 40120,
      "endMs": 41540,
