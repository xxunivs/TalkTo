# === Telegram Bot ===
BOT_TOKEN=
TARGET_CHAT_ID=

# === LLM (Qwen) ===
QWEN_MODEL_PATH=/models/qwen
QWEN_CONTEXT_SIZE=4096

# === STT (Faster-Whisper) ===
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# === TTS (Kokoro) ===
KOKORO_VOICE=ko_kr_default

# === Cognee ===
COGNEE_API_URL=http://cognee-api:8000
COGNEE_DATASET_MASTER=talkto_master
COGNEE_DATASET_OVERLAY=talkto_overlay

# === Conversation ===
SCHEDULE_HOUR=22
MAX_TURNS=10
REPLY_TIMEOUT_SECONDS=120
