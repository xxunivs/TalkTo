# === Telegram Userbot (https://my.telegram.org/apps) ===
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE_NUMBER=
# 발신 대상 (본인 테스트 번호)
TARGET_USER_ID=

# === LLM (Qwen) ===
QWEN_MODEL_PATH=/models/qwen
QWEN_CONTEXT_SIZE=4096

# === STT (Faster-Whisper) ===
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# === TTS (Kokoro) ===
KOKORO_VOICE=ko_kr_default

# === Cognee ===
COGNEE_DATASET_MASTER=talkto_master
COGNEE_DATASET_OVERLAY=talkto_overlay
COGNEE_SYSTEM_DIR=/home/commit/.cognee_system_talkto
COGNEE_DATA_DIR=/home/commit/.cognee_data_talkto

# === Scheduler ===
CALL_INTERVAL_MINUTES=10
CALL_MAX_DURATION_SECONDS=300
