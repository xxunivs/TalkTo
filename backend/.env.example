APP_NAME=TalkTo API
ENVIRONMENT=local
DATABASE_URL=sqlite+aiosqlite:///./talkto.db
JWT_SECRET=change-this-to-a-long-random-secret
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
# 누구나 가입할 수 있게 둔다. false 면 관리자 초대로만 들어온다.
ALLOW_SIGNUP=true

# AI 서버(TalkTo_PersonaAI_AI). 로컬은 8001 에 띄운다. 토큰은 AI 서버 AI_SERVER_TOKEN 과 같게.
# 로컬은 127.0.0.1 로(윈도에서 localhost 는 IPv6 를 먼저 시도해 요청마다 느려진다)
AI_SERVER_URL=http://127.0.0.1:8001
AI_SERVER_TOKEN=
AI_SERVER_TIMEOUT_SECONDS=45
AI_SERVER_LONG_TIMEOUT_SECONDS=1800

# 녹음 저장소. local = 디스크(storage/media), s3 = S3 버킷(운영, EC2 IAM 역할로 접근)
STORAGE_BACKEND=local
LOCAL_MEDIA_DIR=storage/media
LOCAL_MEDIA_PUBLIC_PATH=/media
# AI 서버와 브라우저가 녹음을 내려받을 이 서버의 바깥 주소
PUBLIC_BASE_URL=http://localhost:8000
S3_BUCKET=
S3_REGION=ap-northeast-2
MAX_UPLOAD_MB=300

# 운영 프론트 주소 (JSON 목록). 로컬은 localhost 를 다 열어 둔다.
CORS_ORIGINS=[]
CORS_ALLOW_LOCALHOST=true

# 소셜 로그인이 끝나고 돌아갈 웹 주소(웹이 return_to 를 안 보냈을 때). 운영은 실제 웹 주소로.
FRONTEND_URL=http://localhost:8090
# 소셜 로그인. id·secret 이 둘 다 있어야 그 버튼이 켜진다. 비워 두면 꺼진다.
# 개발자 콘솔에 등록할 Redirect URI 는 {PUBLIC_BASE_URL}/api/v1/auth/oauth/{kakao|google}/callback.
# 로컬은 아래 두 주소를 그대로 등록한다.
#   http://localhost:8000/api/v1/auth/oauth/kakao/callback
#   http://localhost:8000/api/v1/auth/oauth/google/callback
# 카카오: Kakao Developers → 내 애플리케이션 → 앱 키 → REST API 키.
#   카카오 로그인을 켜고 Redirect URI 를 등록한다. 이메일을 받으려면 동의 항목에서 카카오계정(이메일)을 켠다.
KAKAO_CLIENT_ID=
# 카카오: 카카오 로그인 → 보안 → Client Secret (코드를 만들고 '사용함'으로 둔다)
KAKAO_CLIENT_SECRET=
# 카카오 로그인 때 더 묻는 동의. 카카오 디벨로퍼스 동의항목에서 '카카오계정(이메일)'을 켠 뒤에만
# account_email 로 둔다(켜지 않은 항목을 물으면 카카오 로그인이 KOE205 로 막힌다). 비우면 묻지 않는다
KAKAO_EXTRA_SCOPE=
# 구글: Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID(웹 애플리케이션).
#   '승인된 리디렉션 URI' 에 위 구글 주소를 넣는다. 만든 뒤 보이는 클라이언트 ID·보안 비밀번호를 적는다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

BOOTSTRAP_ADMIN_EMAIL=admin@talkto.dev
BOOTSTRAP_ADMIN_PASSWORD=Admin1234!

# ── 요금제·결제 ──
# 결제는 페르소나마다 받는다. 가격(원, 부가세 포함, 페르소나 하나 기준)·한 달 대화 횟수(말하고 대답 듣기 1번 = 1회).
# 2026-10-21 요금 변경 기준(코드 기본값과 같다). 초기 가족 요금은 가족(계정) 단위.
# *_BETA_PRICE = 초기 가족 요금(첫 BETA_FAMILIES 가족 · BETA_MONTHS 개월). 비우면 정식 요금만.
# 무료 체험은 계정 하나에 대화 상대 1개(다 만든 뒤부터). 상한은 지운 것도 센다.
TRIAL_DAYS=7
TRIAL_CONVERSATIONS=30
TRIAL_PERSONAS_PER_ACCOUNT=1
PLAN_MEMORIES_PRICE=9900
PLAN_MEMORIES_BETA_PRICE=4900
PLAN_MEMORIES_CONVERSATIONS=50
PLAN_FAMILY_PRICE=29900
PLAN_FAMILY_BETA_PRICE=14900
PLAN_FAMILY_CONVERSATIONS=300
# 초기 가족 요금을 새로 받을지(false 면 새 가족은 정식 요금, 이미 받은 가족은 기간까지 유지)
BETA_PRICING_OPEN=true
BETA_FAMILIES=100
BETA_MONTHS=12
# 결제 전 모드. false(기본)면 바로 결제하지 않고 '구독 신청'만 받으며, 다 만든 대화 상대는
# 무료 체험 자리를 쓰지 않고 한도 없이 무료로 쓴다. 결제를 열 때 true 로 바꾸고 서버를 다시 켠다.
PAYMENTS_OPEN=false
# 결제 전 모드의 대화 상대마다 한 달(최근 30일) 대화 상한. 비우면 제한 없음(운영 비용이 걱정될 때만).
PRELAUNCH_CONVERSATIONS=
# 가족 공유: 대화 상대 하나에 함께할 수 있는 가족 수(들어온 가족 + 쓸 수 있는 링크, 만든 분 빼고)와
# 초대 링크가 열려 있는 시간. SHARE_OPEN=false 면 새 링크·다시 보내기·참여만 멈춘다(이미 함께하는
# 가족은 그대로 대화한다).
SHARE_MEMBERS_PER_PERSONA=5
SHARE_LINK_HOURS=168
SHARE_OPEN=true
# '더 알려 주실 기억': 대화에 기억 빈틈 표시를 부탁하고 대답 뒤에 가족에게 물을 질문을 만든다.
# AI 서버를 먼저 올린 뒤 켠다(예전 AI 서버는 flagGaps 를 몰라 대화를 막는다).
GAP_QUESTIONS_ENABLED=true
# 토스페이먼츠 자동결제(빌링). 비워 두면 로컬은 '시험 결제'(돈이 오가지 않음), 운영은 결제를 열지 않는다.
# 토스 문서의 공개 테스트 키로 실제 토스 결제창(테스트)을 볼 수 있다:
#   TOSS_CLIENT_KEY=test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq
#   TOSS_SECRET_KEY=test_sk_zXLkKEypNArWmo50nX3lmeaxYG5R
# ⛔ 라이브 키(live_)는 사업자등록·통신판매업 신고·PG 가맹·자동결제 계약·변호사 회신 뒤에만 넣는다.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ── 목소리 ──
# 예전 목소리(ElevenLabs·MiniMax)를 Fish drama-3 로 하나씩 다시 만든다(10분마다 하나, 동의한 분만).
# 다시 만들면 예전 목소리는 그 회사에서 지워 되돌릴 수 없다. 그래서 기본은 false 다. 배포 뒤 관리자
# 대화 상대 하나로 만들기·듣기·다시 만들기·지우기를 확인하고 귀로 들어 본 다음 true 로 켠다.
VOICE_RETRAIN_ENABLED=false
# 말로 답하기(🎤 → 글)를 서버 전체에서 최근 24시간 동안 받아쓸 수 있는 길이(초, 72000 = 20시간).
# 다 쓰면 '잠시 뒤 다시 해 주세요'(503). 0 이하면 끈다. RATE_LIMIT_ENABLED=false 면 세지 않는다.
TRANSCRIPTION_DAILY_SECONDS=72000

# ── 운영 알림 메일(AWS SES v2, app/services/mailer.py) ──
# 새 기억 인터뷰 신청 같은 일을 운영 메일함으로 알린다(개인 정보 없이 '1건'만). 운영에서 둘 다 있을 때만
# 보낸다. MAIL_FROM 은 SES 에서 확인한 도메인 주소(deploy/aws/README.md '운영 알림 메일').
OPS_EMAIL_TO=
MAIL_FROM=
MAIL_REGION=ap-northeast-2
# 고객 메일(mailer.send_user — 계약 내용·동의 녹음 결과·탈퇴 안내). SES 운영 권한(샌드박스 해제)을
# 받은 뒤 true 로 켠다. 끄면 앱 안 알림만 남는다.
USER_MAIL_ENABLED=false


# ── 사업자 정보·동의문 자리표시 ──
# 동의문(app/static/legal/*.md)의 {{상호}} {{대표자}} {{문의 이메일}} {{전화}} 와 사업자 정보 화면에 쓴다.
# 비워 두면 동의문에 '(준비 중)'으로 보인다.
BUSINESS_NAME=
BUSINESS_OWNER=
BUSINESS_EMAIL=
BUSINESS_PHONE=
BUSINESS_REG_NO=
BUSINESS_ADDRESS=
# 통신판매업 신고 번호. 비우면 기본값(제2026-서울용산-1112호, 공개 정보)
MAIL_ORDER_NO=
# 해외 이전 안내의 {{데이터 서버 위치}}. 비우면 '(확인 중)'. 해외 회사의 나라·보관은 문서에 적는다.
LEGAL_DATA_REGION=

# ── 법률 자문 반영(2026-10-22): 미성년 확인 문자·멈춤·동의 녹음 ──
# 만 14세 미만 아이 대화 상대의 법정대리인 확인 문자. off(기본) = 만 14세 미만은 만들 수 없음.
# manual = 대표가 관리자 화면에 뜬 번호로 자기 휴대전화에서 직접 보냄. log = 개발용.
SMS_PROVIDER=off
# manual 일 때 확인 번호 유효 시간(시간)
SMS_MANUAL_CODE_HOURS=24
# 문자 업체를 정했을 때만(키·등록한 발신번호)
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=
# 멈춘 대화 상대를 기한이 지나면 지운다. false 면 지우지 않고 운영 알림만(비상 스위치)
PERSONA_AUTO_DELETE=true
# 한 번(10분)에 지우는 멈춘 대화 상대 수 상한
HOLDS_MAX_DELETES_PER_SWEEP=3
# 멈춘 뒤 지우기까지(일)·아이 14·19세 재동의 기한(개월)
HOLD_DELETE_DAYS=7
MINOR_RECONSENT_MONTHS=6
# 그분 동의 녹음: 검수로 보내는 녹음 수·길이(초)·크기(MB) 상한
SUBJECT_CONSENT_MAX_ATTEMPTS=5
SUBJECT_CONSENT_MAX_SECONDS=900
SUBJECT_CONSENT_MAX_MB=32
# 지운 자료가 서버 백업에 남는 날 수. deploy/aws/stack.yaml 의 BackupRetentionPeriod 와 같게 둔다
DELETION_BACKUP_DAYS=7

# ── 고객센터(GET /api/v1/support) ──
# 카카오톡 채널 1:1 채팅 주소(https://pf.kakao.com/_채널/chat — TalkTo 채널은 아래 값). pf.kakao.com
# 채널 주소만 쓴다(http 는 https 로 바꾸고, 다른 주소면 단추를 숨긴다). 빈 값이면 '카카오톡 채널로
# 문의하기' 단추를 숨긴다(이메일은 BUSINESS_EMAIL 을 보인다). 운영 배포(deploy.py)는 비었거나 채널
# 주소가 아니면 이 TalkTo 채널을 올린다.
KAKAO_CHANNEL_CHAT_URL=https://pf.kakao.com/_nNwwX/chat
# 문의를 받는 때(화면에 그대로 보인다)
SUPPORT_HOURS=평일 10시~18시
